<mxfile host="drawio">
  <diagram id="document-pipeline" name="document-sanity">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="h-in" value="What you write" style="text;html=0;fontFamily=Georgia;fontSize=19;fontStyle=1;fontColor=#172033;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="300" height="30" as="geometry"/>
