        <mxCell id="out2" value="Blog post" style="rounded=1;arcSize=6;html=0;fillColor=#ffffff;strokeColor=#172033;strokeWidth=1.5;fontFamily=Georgia;fontSize=18;fontStyle=1;fontColor=#172033;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="660" y="182" width="300" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="out2d" value="a VitePress page that cites the&#xa;same numbers in prose" style="text;html=0;fontFamily=Georgia;fontSize=14;fontColor=#4f5a6d;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="674" y="216" width="280" height="44" as="geometry"/>
        </mxCell>

        <mxCell id="out3" value="PowerPoint" style="rounded=1;arcSize=6;html=0;fillColor=#ffffff;strokeColor=#172033;strokeWidth=1.5;fontFamily=Georgia;fontSize=18;fontStyle=1;fontColor=#172033;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="660" y="312" width="300" height="102" as="geometry"/>
        </mxCell>
        <mxCell id="out3d" value="for the conference laptop, with the&#xa;manim videos still playing" style="text;html=0;fontFamily=Georgia;fontSize=14;fontColor=#4f5a6d;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="674" y="346" width="280" height="44" as="geometry"/>
        </mxCell>

        <mxCell id="e1" style="html=0;endArrow=block;endFill=1;endSize=7;strokeColor=#2563a8;strokeWidth=1.6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="in1" target="build">
          <mxGeometry relative="1" as="geometry"/>
