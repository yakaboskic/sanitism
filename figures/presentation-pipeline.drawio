<mxfile host="drawio">
  <diagram id="presentation-pipeline" name="presentation-sanity">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="h-in" value="What you write" style="text;html=0;fontFamily=Georgia;fontSize=19;fontStyle=1;fontColor=#172033;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="300" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="h-out" value="What your audience gets" style="text;html=0;fontFamily=Georgia;fontSize=19;fontStyle=1;fontColor=#172033;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="660" y="10" width="300" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="in1" value="manifest.yaml" style="rounded=1;arcSize=8;html=0;fillColor=#eef2f7;strokeColor=#c6d0de;fontFamily=Menlo, Consolas, monospace;fontSize=15;fontStyle=1;fontColor=#172033;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="300" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="in1d" value="numbers, scenes, figures and&#xa;references shared by every talk" style="text;html=0;fontFamily=Georgia;fontSize=14;fontColor=#4f5a6d;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="54" y="82" width="280" height="44" as="geometry"/>
        </mxCell>

        <mxCell id="in2" value="presentations/kickoff/v2/" style="rounded=1;arcSize=8;html=0;fillColor=#eef2f7;strokeColor=#c6d0de;fontFamily=Menlo, Consolas, monospace;fontSize=15;fontStyle=1;fontColor=#172033;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="146" width="300" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="in2d" value="slides.md and blog.md for one talk;&#xa;the next version is a new folder" style="text;html=0;fontFamily=Georgia;fontSize=14;fontColor=#4f5a6d;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="54" y="176" width="280" height="44" as="geometry"/>
        </mxCell>

        <mxCell id="in3" value="scenes/*.py" style="rounded=1;arcSize=8;html=0;fillColor=#eef2f7;strokeColor=#c6d0de;fontFamily=Menlo, Consolas, monospace;fontSize=15;fontStyle=1;fontColor=#172033;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="300" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="in3d" value="manim animations, rendered once&#xa;and played everywhere" style="text;html=0;fontFamily=Georgia;fontSize=14;fontColor=#4f5a6d;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="54" y="270" width="280" height="44" as="geometry"/>
        </mxCell>

        <mxCell id="in4" value="shared/components/" style="rounded=1;arcSize=8;html=0;fillColor=#eef2f7;strokeColor=#c6d0de;fontFamily=Menlo, Consolas, monospace;fontSize=15;fontStyle=1;fontColor=#172033;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="334" width="300" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="in4d" value="&lt;DataValue&gt; and &lt;ManimFigure&gt;,&#xa;the same in the deck and the post" style="text;html=0;fontFamily=Georgia;fontSize=14;fontColor=#4f5a6d;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="54" y="364" width="280" height="44" as="geometry"/>
        </mxCell>

        <mxCell id="build" value="presentation-sanity&#xa;build" style="rounded=1;arcSize=14;html=0;fillColor=#172033;strokeColor=none;fontFamily=Menlo, Consolas, monospace;fontSize=15;fontStyle=1;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="398" y="193" width="214" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="buildd" value="scenes and figures rendered once" style="text;html=0;fontFamily=Georgia;fontSize=13;fontStyle=2;fontColor=#4f5a6d;align=center;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="388" y="274" width="230" height="24" as="geometry"/>
        </mxCell>

        <mxCell id="out1" value="Slidev deck" style="rounded=1;arcSize=6;html=0;fillColor=#ffffff;strokeColor=#172033;strokeWidth=1.5;fontFamily=Georgia;fontSize=18;fontStyle=1;fontColor=#172033;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="660" y="52" width="300" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="out1d" value="presented from the browser,&#xa;or exported to PDF" style="text;html=0;fontFamily=Georgia;fontSize=14;fontColor=#4f5a6d;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="674" y="86" width="280" height="44" as="geometry"/>
