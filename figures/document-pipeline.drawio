        <mxCell id="h-out" value="What your readers get" style="text;html=0;fontFamily=Georgia;fontSize=19;fontStyle=1;fontColor=#172033;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="660" y="10" width="300" height="30" as="geometry"/>
